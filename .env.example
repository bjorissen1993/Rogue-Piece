# Frontend (Vite)
# Empty string = same-origin (Vite proxy in dev / nginx in prod).
# Set to "off" to force guest-only builds.
VITE_API_URL=

# Google emails that may see Sandbox / Development profile on production builds.
# Local `npm run dev` always shows it. Example: you@gmail.com
VITE_DEV_ACCESS_EMAILS=

# API server — never commit real secrets
DATABASE_URL=postgres://postgres:postgres@localhost:5432/roguepiece
APP_URL=http://localhost:5173
API_URL=http://localhost:3001
AUTH_SECRET=replace-with-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CORS_ORIGINS=http://localhost:5173
PORT=3001

# Google OAuth redirect URIs (must match Console exactly):
#   http://localhost:3001/auth/google/callback
#   https://api.roguepiece.freakydev.com/auth/google/callback

# Production (Hostnet SPA + Railway API/Postgres):
# See .env.production.example and server/.env.production.example
# APP_URL=https://roguepiece.freakydev.com
# API_URL=https://api.roguepiece.freakydev.com
# VITE_API_URL=https://api.roguepiece.freakydev.com
# CORS_ORIGINS=https://roguepiece.freakydev.com
