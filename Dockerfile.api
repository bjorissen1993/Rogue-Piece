# API image — used only when Config-as-code = /railway.api.toml
FROM node:22-alpine

WORKDIR /app

COPY server/package.json server/package-lock.json ./
RUN npm ci

COPY server/tsconfig.json ./
COPY server/drizzle.config.ts ./
COPY server/drizzle ./drizzle
COPY server/src ./src

RUN npm run build \
  && npm prune --omit=dev

ENV NODE_ENV=production
EXPOSE 3000

CMD ["npm", "start"]
